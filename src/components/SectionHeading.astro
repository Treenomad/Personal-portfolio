---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<div class="section-heading">
  <div class="eyebrow"><span></span>{eyebrow}</div>
  <div class="section-title-row">
    <h2>{title}</h2>
    {description && <p>{description}</p>}
  </div>
</div>
