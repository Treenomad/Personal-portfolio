---
import { copy, site, type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const text = copy[lang];
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href={lang === 'zh' ? '/' : '/en/'} aria-label={lang === 'zh' ? '返回首页' : 'Back to home'}>
      <span class="wordmark-mark" aria-hidden="true">HS</span>
      <span class="wordmark-text">
        <strong>{site.nameEn}</strong>
        <small>INDUSTRIAL AI</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label={lang === 'zh' ? '主导航' : 'Main navigation'}>
      {text.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="header-actions">
      <a class="language-link" href={text.langHref}>{text.langLabel}</a>
      <details class="site-menu">
        <summary aria-label={lang === 'zh' ? '打开导航' : 'Open navigation'}><span></span><span></span></summary>
        <div class="mobile-panel">
          {text.nav.map((item, index) => (
            <a href={item.href}><span>0{index + 1}</span>{item.label}</a>
          ))}
        </div>
      </details>
    </div>
  </div>
</header>
